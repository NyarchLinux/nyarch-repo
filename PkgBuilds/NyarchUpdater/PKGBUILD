pkgname=nyarchupdater
pkgver=0.1.11
pkgrel=1
pkgdesc="Keep your Nyarch Linux system up to date"
arch=(x86_64)
license=(GPL-3.0)
url="https://github.com/NyarchLinux/NyarchUpdater"
depends=(
    gjs
    gtk4
    libadwaita
    glib2
    desktop-file-utils
)
makedepends=(
    meson
    ninja
    gi-docgen
    appstream
    gettext
)
source=("git+https://github.com/NyarchLinux/NyarchUpdater.git")
sha256sums=('SKIP')

build() {
    cd "NyarchUpdater"
    meson setup build --prefix=/usr -Ddatadir=/usr/share
    meson compile -C build
}

package() {
    cd "NyarchUpdater"
    meson install -C build
}
