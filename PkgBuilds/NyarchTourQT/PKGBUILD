pkgname=nyarchtourqt
pkgver=0.1.0.r6.gd2a176e
pkgrel=1
pkgdesc="Nyarch Tour - A KDE Kirigami tour application for Nyarch Linux"
arch=('any')
url="https://github.com/NyarchLinux/NyarchTourQT"
license=('GPL-3.0-or-later')
depends=(
  'hicolor-icon-theme'
  'kirigami'
  'python'
  'pyside6'
)
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/NyarchTourQT"
  _ver=$(git describe --long --tags 2>/dev/null | sed 's/\([^-]*-\)g/r\1/;s/-/./g')
  if [[ -n "${_ver}" ]]; then
    echo "${_ver}"
  else
    printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  cd "${srcdir}/NyarchTourQT"
  # pyproject.toml references README.md - create a minimal one if missing.
  [[ -f README.md ]] || echo "# Nyarch Tour QT" > README.md
}

build() {
  cd "${srcdir}/NyarchTourQT"
  python -m build --wheel
}

package() {
  cd "${srcdir}/NyarchTourQT"
  python -m installer --destdir="${pkgdir}" dist/*.whl

  # Desktop integration (desktop file, metainfo, icon).
  install -Dm644 moe.nyarchlinux.tourqt.desktop -t "${pkgdir}/usr/share/applications"
  install -Dm644 moe.nyarchlinux.tourqt.metainfo.xml -t "${pkgdir}/usr/share/metainfo"
  install -Dm644 moe.nyarchlinux.tourqt.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/moe.nyarchlinux.tourqt.svg"
}
