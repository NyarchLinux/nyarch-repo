# SPDX-License-Identifier: GPL-3.0-or-later

pkgname=catgirldownloader
pkgver=0.5.r0.6793a5a
pkgrel=1
pkgdesc="GTK4 app to download images from nekos.moe and related APIs"
arch=('any')
url="https://github.com/NyarchLinux/CatgirlDownloader"
license=('GPL-3.0-or-later')
depends=(
  'dconf'
  'gdk-pixbuf2'
  'glib2'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'pango'
  'python'
  'python-gobject'
  'python-requests'
)
makedepends=('git' 'meson')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/CatgirlDownloader"
  _ver=$(git describe --long --tags 2>/dev/null | sed 's/\([^-]*-\)g/r\1/;s/-/./g')
  if [[ -n "${_ver}" ]]; then
    echo "${_ver}"
  else
    printf "0.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build() {
  if [[ -d build ]]; then
    rm -rf build
  fi
  arch-meson CatgirlDownloader build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs || :
}

package() {
  meson install -C build --destdir "$pkgdir"
  chmod +x "${pkgdir}/usr/bin/${pkgname}"
  cd CatgirlDownloader
  install -Dm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
